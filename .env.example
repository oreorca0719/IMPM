# ===== Backend =====
# 관리 대상 제품: STRIPE · 이 관리 도구: IMPM
DATABASE_URL=sqlite+aiosqlite:///./data/impm.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Frontend (Vite) =====
# 프론트 빌드시 주입. 개발 중에는 vite proxy(/api)를 사용하므로 비워도 됨.
VITE_API_BASE=/api

# ===== Backup (P8) =====
S3_BUCKET=impm-backups
AWS_REGION=ap-northeast-2
